# ============================================================
# AuthSentinel - Environment Variables
# Salin file ini menjadi .env dan isi nilainya
# ============================================================

# Server
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5500

# Database PostgreSQL (AWS RDS)
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=5432
DB_NAME=authsentinel_db
DB_USER=authsentinel_user
DB_PASSWORD=your_strong_password_here
DB_SSL=true

# JWT Secret (minimal 64 karakter!)
JWT_SECRET=your_super_secret_jwt_key_minimum_64_characters_long_change_this
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Bcrypt
BCRYPT_ROUNDS=12
